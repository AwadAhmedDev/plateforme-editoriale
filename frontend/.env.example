# Variables d'environnement Prisma / Supabase — cf. docs/project/prisma-config-specification.md
#
# Ne jamais committer le fichier .env réel (voir .gitignore : `.env*`).
# Copier ce fichier en `.env` puis renseigner les valeurs réelles du projet Supabase.

# Connexion DIRECTE PostgreSQL (port 5432) — utilisée EXCLUSIVEMENT par le CLI Prisma
# (migrate, generate, db pull/push, studio, validate), via prisma.config.ts.
# Ne jamais utiliser cette variable comme connexion applicative au runtime
# (prisma-config-specification.md §2 — règle stricte).
DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"

# Connexion POOLÉE Supavisor, mode transaction (port 6543) — utilisée EXCLUSIVEMENT par le
# Client Prisma applicatif (via l'adaptateur @prisma/adapter-pg), jamais par le CLI.
# Paramètre `pgbouncer=true` requis en mode transaction (prisma-config-specification.md §2-§3).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Base fantôme utilisée par `prisma migrate dev` pour détecter la dérive de schéma en
# développement local. CONDITIONNELLE : requise uniquement si l'option (a) de
# prisma-config-specification.md §4 est retenue (base dédiée, distincte de l'instance
# Supabase de développement). Si l'option (b) est retenue à la place (flux
# `prisma migrate dev --create-only` puis `prisma migrate deploy`, sans jamais laisser le
# CLI gérer une base fantôme contre Supabase), cette variable peut rester vide.
# Point d'arbitrage non tranché — cf. prisma-config-specification.md §4.
SHADOW_DATABASE_URL=""

# URL absolue de production, utilisée exclusivement par l'API Metadata de
# Next.js (canonical, Open Graph, Twitter — Lot L7a et suivants). Jamais
# préfixée NEXT_PUBLIC_ : consommée uniquement côté serveur (app/layout.tsx).
# OBLIGATOIRE en production (échec de build explicite si absente) ;
# facultative en développement (repli automatique sur http://localhost:3000).
SITE_URL="https://<domaine-de-production>"
