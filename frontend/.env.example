# Variables d'environnement — cf. docs/project/prisma-config-specification.md (base de
# données), docs/project/security-specification.md §11 (secrets) et
# docs/project/deployment.md §Variables d'environnement (provisionnement).
#
# Ne jamais committer le fichier .env réel (voir .gitignore).
# Copier ce fichier en `.env` puis renseigner les valeurs réelles.
#
# Ce fichier liste TOUTES les variables réellement lues par le code. Un environnement
# provisionné depuis ce modèle est complet — c'est la condition du point 3 de la procédure
# de `deployment.md`. Trois modes de défaillance selon la variable manquante :
#   - SITE_URL          → échec au build, immédiat ;
#   - base et session   → échec à la première requête concernée ;
#   - R2_*              → échec au premier upload d'image seulement, le reste du site
#                         fonctionnant normalement (lecture paresseuse dans
#                         src/lib/media/storage-client.ts).

# Connexion DIRECTE PostgreSQL (port 5432) — utilisée EXCLUSIVEMENT par le CLI Prisma
# (migrate, generate, db pull/push, studio, validate), via prisma.config.ts.
# Ne jamais utiliser cette variable comme connexion applicative au runtime
# (prisma-config-specification.md §2 — règle stricte).
DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"

# Connexion POOLÉE Supavisor, mode transaction (port 6543) — utilisée EXCLUSIVEMENT par le
# Client Prisma applicatif (via l'adaptateur @prisma/adapter-pg), jamais par le CLI.
# Paramètre `pgbouncer=true` requis en mode transaction (prisma-config-specification.md §2-§3).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Base fantôme utilisée par `prisma migrate dev` pour détecter la dérive de schéma en
# développement local. CONDITIONNELLE : requise uniquement si l'option (a) de
# prisma-config-specification.md §4 est retenue (base dédiée, distincte de l'instance
# Supabase de développement). Si l'option (b) est retenue à la place (flux
# `prisma migrate dev --create-only` puis `prisma migrate deploy`, sans jamais laisser le
# CLI gérer une base fantôme contre Supabase), cette variable peut rester vide.
# Point d'arbitrage non tranché — cf. prisma-config-specification.md §4.
SHADOW_DATABASE_URL=""

# URL absolue de production, utilisée exclusivement par l'API Metadata de
# Next.js (canonical, Open Graph, Twitter — Lot L7a et suivants). Jamais
# préfixée NEXT_PUBLIC_ : consommée uniquement côté serveur (app/layout.tsx).
# OBLIGATOIRE en production (échec de build explicite si absente) ;
# facultative en développement (repli automatique sur http://localhost:3000).
SITE_URL="https://<domaine-de-production>"

# --- Session administrateur ---------------------------------------------------------

# Secret de hachage et de signature des jetons de session (src/lib/auth/token.ts).
# security-specification.md §11 laissait le nom de cette variable en point d'arbitrage
# (« aucun document ne nomme explicitement une variable d'environnement dédiée — à
# créer ») : SESSION_SECRET est le nom retenu par l'implémentation.
# OBLIGATOIRE dans tous les environnements — l'authentification lève sans elle.
# Chaîne aléatoire longue, distincte des chaînes de connexion Supabase, jamais commitée.
SESSION_SECRET=""

# Durée d'inactivité avant expiration de session, en minutes (DR-002), strictement
# positive. Lue par src/features/admin-auth/session.ts, qui lève explicitement si elle
# est absente : aucune valeur par défaut n'est appliquée, la durée devant être un choix
# documenté (security-specification.md §2, §14) et non un implicite de code.
# OBLIGATOIRE dans tous les environnements.
SESSION_INACTIVITY_TIMEOUT_MINUTES="30"

# --- Stockage objet Cloudflare R2 ---------------------------------------------------

# Identifiants du stockage objet de l'image principale des articles
# (security-specification.md §11, technical-architecture.md §8 point 3). Les cinq
# variables sont lues par src/lib/media/storage-client.ts via `requireEnv`, de façon
# PARESSEUSE : leur absence ne casse ni l'import du module, ni le build, ni le site
# public — seule l'exécution d'un upload lève. Elles n'en sont pas facultatives pour
# autant : l'image principale et son texte alternatif sont requis pour publier un
# article, donc un environnement sans ces valeurs ne permet aucune publication.
# OBLIGATOIRES dans tous les environnements.

# Identifiant du compte Cloudflare, utilisé pour construire l'endpoint S3 de R2.
R2_ACCOUNT_ID=""

# Clé d'accès et secret du jeton d'API R2 (permissions lecture/écriture sur le bucket).
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""

# Nom du bucket recevant les images d'articles.
R2_BUCKET_NAME=""

# Domaine public de diffusion du bucket. Double usage, contrairement aux quatre
# précédentes : construction des URLs d'image côté serveur, ET dérivation de
# `images.remotePatterns` dans next.config.ts au moment du build. Son absence y est
# tolérée sans erreur (remotePatterns reste vide) — conséquence à connaître : en
# production sans cette variable, next/image refusera les images R2 alors que le build
# aura réussi. Sans barre oblique finale.
R2_PUBLIC_URL="https://<domaine-public-r2>"

# --- E-mails (Resend) ----------------------------------------------------------------

# Clé API Resend (https://resend.com/api-keys). Sans elle, aucun e-mail ne part, mais
# les formulaires continuent de fonctionner (src/lib/email/send-email.ts ne lève jamais).
RESEND_API_KEY=""

# Expéditeur, sur un domaine vérifié dans Resend. Ex. : "Corne de l'Afrique <newsletter@domaine.fr>"
EMAIL_FROM=""

# Adresse de la rédaction qui reçoit une alerte à chaque message de contact.
CONTACT_NOTIFICATION_EMAIL=""

# --- Anti-robot (Cloudflare Turnstile) -----------------------------------------------

# Clés du widget (Cloudflare > Turnstile). La clé de site est publique par conception
# (préfixe NEXT_PUBLIC_, lue au build) ; la clé secrète reste côté serveur.
# OBLIGATOIRES en production : sans la clé secrète, la vérification est ignorée.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Jeton Cloudflare Web Analytics (Cloudflare > Web Analytics > Add a site, mode JS snippet).
# Public par conception. Absent : aucun script de mesure chargé.
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=""
