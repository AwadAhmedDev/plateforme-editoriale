generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TypeContenu {
  article
  analyse
  enquete
  interview
  dossier_thematique
  rapport

  @@map("type_contenu")
}

enum StatutContenu {
  brouillon
  publie
  archive

  @@map("statut_contenu")
}

model Categorie {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nom               String   @unique
  slug              String   @unique
  descriptionCourte String?  @map("description_courte")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  contenus ContenuEditorial[]

  @@map("categorie")
}

model ZoneGeographique {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nom               String   @unique
  slug              String   @unique
  descriptionCourte String?  @map("description_courte")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  contenus ContenuEditorial[]

  @@map("zone_geographique")
}

model Administrateur {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifiant    String   @unique
  motDePasseHash String   @map("mot_de_passe_hash")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  sessions SessionAdministrateur[]

  @@map("administrateur")
}

model SessionAdministrateur {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  administrateurId   String   @map("administrateur_id") @db.Uuid
  jetonHash          String   @unique @map("jeton_hash")
  derniereActiviteAt DateTime @default(now()) @map("derniere_activite_at") @db.Timestamptz
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz

  administrateur Administrateur @relation(fields: [administrateurId], references: [id], onDelete: Cascade)

  @@index([administrateurId])
  @@map("session_administrateur")
}

// État d'étranglement de la surface de connexion administrateur
// (security-specification.md §10, point d'arbitrage brute force tranché).
//
// Délibérément SANS relation vers Administrateur : le compteur décrit la surface de
// connexion, jamais un compte. Un identifiant inconnu n'a aucune ligne à incrémenter —
// rattacher l'état à un compte rendrait le délai observable uniquement sur les comptes
// existants, ce qui reconstituerait le canal d'énumération que §9 ferme (message
// générique + comparaison bcrypt systématique). L'état est donc consulté et incrémenté
// à l'identique, que l'identifiant soumis existe ou non.
//
// Clé primaire textuelle et non UUID, seul écart au reste du schéma : une valeur
// constante (`ADMIN_LOGIN`) garantit structurellement l'unicité de la ligne, là où un
// `gen_random_uuid()` en autoriserait plusieurs. La ligne est insérée par la migration,
// jamais créée à la volée — un upsert en chemin de requête introduirait une course.
model EtranglementConnexion {
  surface           String    @id
  echecsConsecutifs Int       @default(0) @map("echecs_consecutifs")
  dernierEchecAt    DateTime? @map("dernier_echec_at") @db.Timestamptz

  @@map("etranglement_connexion")
}

model ContenuEditorial {
  id                       String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug                     String                   @unique
  titre                    String?
  chapo                    String?
  corps                    String?
  typeContenu              TypeContenu?             @map("type_contenu")
  categorieId              String?                  @map("categorie_id") @db.Uuid
  zoneId                   String?                  @map("zone_id") @db.Uuid
  imagePrincipaleUrl       String?                  @map("image_principale_url")
  imageAltText             String?                  @map("image_alt_text")
  imageLargeur             Int?                     @map("image_largeur")
  imageHauteur             Int?                     @map("image_hauteur")
  auteur                   String?
  sources                  String?
  statut                   StatutContenu            @default(brouillon)
  datePublication          DateTime?                @map("date_publication") @db.Timestamptz
  dateDerniereModification DateTime                 @default(now()) @map("date_derniere_modification") @db.Timestamptz
  createdAt                DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  // Maintenu exclusivement par trigger PL/pgSQL (cf. rapport) — jamais lu/écrit via Prisma Client.
  rechercheVecteur         Unsupported("tsvector")? @map("recherche_vecteur")

  categorie Categorie?        @relation(fields: [categorieId], references: [id], onDelete: Restrict)
  zone      ZoneGeographique? @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  motsCles  ContenuMotCle[]

  @@index([statut, datePublication(sort: Desc)])
  @@index([categorieId])
  @@index([zoneId])
  @@map("contenu_editorial")
}

model ContenuMotCle {
  contenuId String @map("contenu_id") @db.Uuid
  motCle    String @map("mot_cle")

  contenu ContenuEditorial @relation(fields: [contenuId], references: [id], onDelete: Cascade)

  @@id([contenuId, motCle])
  @@index([motCle])
  @@map("contenu_mot_cle")
}

model MessageContact {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nom       String
  email     String
  // TEXT + valeurs de code fermées côté Zod (contact-schema.ts), pas un ENUM Postgres
  // natif — même choix que InscritNewsletter.statut ci-dessous (cf. rapport).
  objet     String
  message   String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([createdAt(sort: Desc)])
  @@map("message_contact")
}

model InscritNewsletter {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email               String    @unique
  dateInscription     DateTime  @default(now()) @map("date_inscription") @db.Timestamptz
  // TEXT + CHECK côté SQL, pas un type ENUM Postgres natif : reste un String Prisma (cf. rapport).
  statut              String    @default("inscrit")
  jetonDesinscription String?   @unique @map("jeton_desinscription")
  desinscritAt        DateTime? @map("desinscrit_at") @db.Timestamptz

  @@map("inscrit_newsletter")
}
